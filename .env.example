# Copy to `.env`. Every value below has a working default, so an empty file
# (or no file at all) still gives you a running, fully deterministic API.
#
#   cp .env.example .env
#
# `npm run server` loads .env if it exists and shrugs if it does not.

# ---- provider keys ------------------------------------------------------
# Any one of these turns the model edges on. Set several and the server can
# use all of them: `PATHFINDER_PROVIDERS` sets the failover order, a request
# may name one for itself, and `POST /api/providers/check` calls each key
# once so you can prove every one of them works.
#
# Empty is a valid setting. With no key at all the server runs fully
# deterministic, every route still answers, and /api/health reports
# `llm.enabled: false`. No quotes, no spaces around the "=".
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=
GROQ_API_KEY=
MISTRAL_API_KEY=

# Failover order, tried left to right. Anything without a key is skipped.
# PATHFINDER_PROVIDERS=anthropic,openai,google,groq,mistral

# On a provider failure, try the next configured provider before answering
# deterministically. Off means one attempt, then the rules.
# PATHFINDER_PROVIDER_FALLBACK=on

# Let a request pick its own provider: {"provider":"openai", ...}. On for the
# demo, because it is how one endpoint exercises every key. Turn it off if
# this API is ever exposed.
# PATHFINDER_ALLOW_PROVIDER_OVERRIDE=on

# Per-provider model overrides. Defaults are in server/providers.ts.
# PATHFINDER_MODEL_ANTHROPIC=claude-opus-5
# PATHFINDER_MODEL_OPENAI=gpt-4.1-mini
# PATHFINDER_MODEL_GOOGLE=gemini-2.0-flash
# PATHFINDER_MODEL_GROQ=llama-3.3-70b-versatile
# PATHFINDER_MODEL_MISTRAL=mistral-large-latest

# auto (default) = use the model when any provider has a key
# on             = same as auto; LangChain needs an explicit key, so there is
#                  nothing extra to try
# off            = never call out, guaranteed offline. Use this to rehearse.
# PATHFINDER_LLM=auto

# Hard ceiling per model call. After this we stop waiting and serve the
# deterministic answer, so bad wifi costs seconds, not the demo.
# PATHFINDER_LLM_TIMEOUT_MS=8000
# PATHFINDER_LLM_MAX_RETRIES=0

# ---- spend --------------------------------------------------------------
# Process-wide caps. Hitting one degrades to deterministic answers rather
# than erroring, and shows up in /api/health. 0 disables a cap.
# PATHFINDER_BUDGET_MAX_CALLS=500
# PATHFINDER_BUDGET_MAX_TOKENS=2000000
# PATHFINDER_BUDGET_MAX_USD=5
# 0 = counters run for the life of the process.
# PATHFINDER_BUDGET_WINDOW_MS=0

# Rough list prices for the cap above, USD per million tokens "input,output".
# Only ever used for local accounting — nothing here is a bill.
# PATHFINDER_PRICE_OPENAI=0.4,1.6

# Per-IP ceiling on the four routes that can spend money.
# PATHFINDER_LLM_RATE_LIMIT=30
# PATHFINDER_LLM_RATE_WINDOW_MS=60000

# ---- guardrails ---------------------------------------------------------
# What to do with a message that looks like a prompt-injection attempt.
# deterministic (default) = answer it with the rules, model not consulted
# sanitize                = keep the model, rely on the fence and the
#                           output checks alone
# PATHFINDER_INJECTION_POLICY=deterministic

# Extra comma-separated terms that route a message to the deterministic
# path. Empty by default: a wordlist baked into the source is one nobody can
# tune for their own learners.
# PATHFINDER_BLOCK_TERMS=

# Ceilings enforced on model output, not merely requested in the prompt.
# Prose that exceeds them is discarded and the deterministic text is served.
# PATHFINDER_MAX_REPLY_SENTENCES=4
# PATHFINDER_MAX_REPLY_CHARS=900
# PATHFINDER_MAX_NARRATION_SENTENCES=4
# PATHFINDER_MAX_NARRATION_CHARS=700

# Below this confidence the extractor's answer is ignored and keywords decide.
# PATHFINDER_CONFIDENCE_FLOOR=0.55

# ---- server -------------------------------------------------------------
# PORT=8787
# HOST=127.0.0.1
# PATHFINDER_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# When set, every /api route except the index and liveness needs
# `Authorization: Bearer <key>` (or `x-api-key`). Leave unset for localhost;
# set it before binding to anything a stranger can reach.
# PATHFINDER_API_KEY=

# Only turn on when a reverse proxy really is setting X-Forwarded-For.
# Trusting it otherwise makes the per-IP limiter a header anyone can rewrite.
# PATHFINDER_TRUST_PROXY=off
