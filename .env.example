# Copy to `.env`. Every value below has a working default, so an empty file
# (or no file at all) still gives you a running, fully deterministic API.
#
#   cp .env.example .env
#
# `npm run server` loads .env if it exists and shrugs if it does not.

# ---- the model ----------------------------------------------------------
# The one line you actually have to fill in, so it is deliberately NOT
# commented out — a straight copy of this file should be ready to paste a key
# into. Empty is a valid setting: the server runs fully deterministic, every
# route still answers, and /api/health reports `llm.enabled: false`.
# No quotes, no spaces around the "=".
ANTHROPIC_API_KEY=

# auto (default) = use the model only if a key is in the environment
# on             = always try; the SDK may also use an `ant auth login` profile
# off            = never call out, guaranteed offline. Use this to rehearse.
# PATHFINDER_LLM=auto

# PATHFINDER_MODEL=claude-opus-5

# Hard ceiling per model call. After this we stop waiting and serve the
# deterministic answer, so bad wifi costs seconds, not the demo.
# PATHFINDER_LLM_TIMEOUT_MS=8000
# PATHFINDER_LLM_MAX_RETRIES=1

# Server-side refusal fallbacks (beta). Set to `off` if the beta is not
# enabled on the account, otherwise every call 400s and quietly degrades.
# PATHFINDER_LLM_FALLBACKS=on

# ---- server -------------------------------------------------------------
# PORT=8787
# HOST=127.0.0.1
# PATHFINDER_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Per-IP ceiling on the three routes that can spend money.
# PATHFINDER_LLM_RATE_LIMIT=30
# PATHFINDER_LLM_RATE_WINDOW_MS=60000
