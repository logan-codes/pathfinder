{
  "name": "learning-path-recommender",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "server": "node --env-file-if-exists=.env --import tsx server/index.ts",
    "server:dev": "node --env-file-if-exists=.env --import tsx --watch server/index.ts",
    "server:check": "tsc -p server/tsconfig.json",
    "check": "tsc -b && tsc -p server/tsconfig.json",
    "smoke": "node --env-file-if-exists=.env --import tsx scripts/smoke.ts",
    "author:quiz": "node --env-file-if-exists=.env --import tsx scripts/author-quiz.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.121.0",
    "@langchain/anthropic": "^1.5.8",
    "@langchain/core": "^1.2.9",
    "@langchain/google-genai": "^2.3.0",
    "@langchain/groq": "^1.3.1",
    "@langchain/mistralai": "^1.2.0",
    "@langchain/openai": "^1.5.10",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "helmet": "^8.3.0",
    "lucide-react": "^0.400.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.0.0",
    "zod": "^4.4.3",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^26.4.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "tsx": "^4.23.12",
    "typescript": "^5.6.0",
    "vite": "^6.0.0"
  },
  "engines": {
    "node": ">=20.19"
  }
}
